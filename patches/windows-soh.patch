diff --git a/soh/soh/Extractor/FastCrc32C.c b/soh/soh/Extractor/FastCrc32C.c
index fca6b97f3..51c075746 100644
--- a/soh/soh/Extractor/FastCrc32C.c
+++ b/soh/soh/Extractor/FastCrc32C.c
@@ -5,7 +5,9 @@
 // Clang will define both __llvm__ and __GNUC__ but GCC will only define __GNUC__. So we need to check for __llvm__
 // first.
 #if ((defined(__llvm__) && (defined(__x86_64__) || defined(__i386__))))
+#ifndef _WIN32
 #pragma clang attribute push(__attribute__((target("crc32"))), apply_to = function)
+#endif
 #elif ((defined(__GNUC__) && (defined(__x86_64__) || defined(__i386__))))
 // GCC Only lets you enable all of sse4.2 so we will for just this file and reset it at the end.
 #pragma GCC push_options
@@ -34,6 +36,11 @@
 #define NO_CRC_INTRIN
 #endif
 
+// ClangCL must not apply target attributes to Windows intrinsic header declarations.
+#if defined(_WIN32) && defined(__llvm__) && (defined(__x86_64__) || defined(__i386__))
+#pragma clang attribute push(__attribute__((target("crc32"))), apply_to = function)
+#endif
+
 #if defined(_MSC_VER) && defined(_M_ARM64)
 #define INTRIN_CRC32_64(crc, data) crc = (uint32_t)__crc32cd(crc, data)
 #define INTRIN_CRC32_32(crc, data) crc = __crc32cw(crc, data)
